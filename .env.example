# Replace all placeholders before starting Compose.
DB_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_YOUR_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
INTERNAL_SERVICE_KEY=REPLACE_WITH_YOUR_INTERNAL_SERVICE_KEY
RABBIT_USER=toeic
RABBIT_PASSWORD=REPLACE_WITH_YOUR_BROKER_PASSWORD
GATEWAY_PORT=8088
RABBIT_UI_PORT=15672
ALLOW_DEMO_PLAN_CHANGE=true
# Optional teacher account, created only when both values supplied:
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
